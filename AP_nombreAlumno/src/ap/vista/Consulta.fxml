<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="720.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ap.controlador.ConsultaController">
   <top>
      <VBox styleClass="cabecera" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="titulo" text="ALQUILER DE PATINETES" />
            <Label styleClass="subtitulo" text="Consulta de alquileres" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="26.0" right="26.0" top="22.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="etiqueta" text="DNI" />
                  <TextField fx:id="txtDni" prefWidth="200.0" promptText="12345678A" />
                  <Button fx:id="btnBuscar" defaultButton="true" mnemonicParsing="false" onAction="#onBuscar" styleClass="boton, boton-primario" text="Buscar" />
               </children>
            </HBox>
            <TableView fx:id="tabla" fixedCellSize="34.0" prefHeight="210.0">
               <columns>
                  <TableColumn fx:id="colNombre" text="Nombre" />
                  <TableColumn fx:id="colNumSerie" text="Nº Serie" />
                  <TableColumn fx:id="colRecogida" text="F. Recogida" />
                  <TableColumn fx:id="colDevolucion" text="F. Devolución" />
               </columns>
            </TableView>
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#onAnterior" styleClass="boton, boton-secundario" text="‹ Anterior" />
                  <Label fx:id="lblPagina" minWidth="110.0" styleClass="pagina" text="Página 1 de 1" />
                  <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#onSiguiente" styleClass="boton, boton-secundario" text="Siguiente ›" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="pie" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnAlta" mnemonicParsing="false" onAction="#onAlta" styleClass="boton, boton-primario" text="Alta" />
            <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminar" styleClass="boton, boton-peligro" text="Eliminar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSalir" mnemonicParsing="false" onAction="#onSalir" styleClass="boton, boton-secundario" text="Salir" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
