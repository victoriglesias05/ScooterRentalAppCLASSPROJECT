<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefWidth="580.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ap.controlador.ListaPatinetesController">
   <top>
      <VBox styleClass="cabecera" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="titulo" text="LISTA DE PATINETES" />
            <Label styleClass="subtitulo" text="Elige un patinete (doble clic o botón Seleccionar)" />
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="8.0" left="26.0" right="26.0" top="22.0" />
         </padding>
         <children>
            <TableView fx:id="tabla" fixedCellSize="30.0" prefHeight="344.0">
               <columns>
                  <TableColumn fx:id="colNumSerie" text="Nº Serie" />
                  <TableColumn fx:id="colColor" text="Color" />
                  <TableColumn fx:id="colModelo" text="Modelo" />
                  <TableColumn fx:id="colMarca" text="Marca" />
               </columns>
            </TableView>
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Button fx:id="btnAnterior" mnemonicParsing="false" onAction="#onAnterior" styleClass="boton, boton-secundario" text="‹ Anterior" />
                  <Label fx:id="lblPagina" minWidth="110.0" styleClass="pagina" text="Página 1 de 1" />
                  <Button fx:id="btnSiguiente" mnemonicParsing="false" onAction="#onSiguiente" styleClass="boton, boton-secundario" text="Siguiente ›" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="pie" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnCancelar" cancelButton="true" mnemonicParsing="false" onAction="#onCancelar" styleClass="boton, boton-secundario" text="Cancelar" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnSeleccionar" defaultButton="true" mnemonicParsing="false" onAction="#onSeleccionar" styleClass="boton, boton-primario" text="Seleccionar" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
